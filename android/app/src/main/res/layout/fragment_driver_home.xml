<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/driver_my_vehicle"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" app:cardCornerRadius="14dp"
                app:cardElevation="0dp" app:strokeWidth="1dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">
                    <TextView android:id="@+id/vehicleRegistration" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleLarge"
                        tools:text="KA-01-AB-1234" />
                    <TextView android:id="@+id/vehicleDetails" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium"
                        tools:text="Tata Ace · 2022 · Diesel" />
                    <TextView android:id="@+id/vehicleMileage" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodySmall"
                        tools:text="48596 km" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:id="@+id/tripHeader" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="22dp"
                android:text="@string/driver_next_trip"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <com.google.android.material.card.MaterialCardView android:id="@+id/tripCard"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:visibility="gone"
                app:cardCornerRadius="14dp" app:cardElevation="0dp" app:strokeWidth="1dp"
                tools:visibility="visible">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView android:id="@+id/tripNumber" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceLabelLarge" tools:text="TRP1007" />
                        <com.google.android.material.chip.Chip android:id="@+id/tripStatus"
                            style="@style/Widget.Material3.Chip.Assist" android:layout_width="wrap_content"
                            android:layout_height="30dp" android:clickable="false" tools:text="Scheduled" />
                    </LinearLayout>

                    <TextView android:id="@+id/tripRoute" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        tools:text="Bangalore → Chennai" />

                    <TextView android:id="@+id/tripSchedule" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="2dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        tools:text="23 Aug 2026, 13:30 → 23:30" />

                    <TextView android:id="@+id/tripProgress" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="6dp"
                        android:textAppearance="?attr/textAppearanceBodySmall" android:visibility="gone"
                        tools:text="Started at 13:55 · odometer 48250" tools:visibility="visible" />

                    <com.google.android.material.button.MaterialButton android:id="@+id/tripActionButton"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:layout_marginTop="14dp" tools:text="Start trip" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView android:id="@+id/emptyTrip" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:text="@string/driver_no_trip" android:textAppearance="?attr/textAppearanceBodyLarge"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
