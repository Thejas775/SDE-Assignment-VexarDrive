# cp .env.example .env  --  .env is gitignored, never commit real values here

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
LOG_JSON=false
RUN_MIGRATIONS_ON_STARTUP=true
PROJECT_NAME=Fleet Management API
API_V1_PREFIX=/api/v1

SECRET_KEY=thejas-elandassery-super-secret-key-marvel-jesus
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_MIN_LENGTH=8

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleet
POSTGRES_DB=fleet_db
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

DOCUMENT_EXPIRY_WARNING_DAYS=30
MAINTENANCE_DUE_WARNING_DAYS=7
MAINTENANCE_DUE_MILEAGE_BUFFER=500
LOCATION_PING_INTERVAL_SECONDS=30
